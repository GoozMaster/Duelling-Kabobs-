# Copy to .env.local and fill in with your Supabase project's values.
# Find them in the Supabase dashboard under Project Settings -> API Keys.
#
# Both values are safe to expose to the browser: the publishable key only ever
# grants access allowed by your Row Level Security policies. Never put the
# service_role / secret key in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The single admin account. Anyone signing in with a different address is
# signed straight back out. This MUST match the email literal inside
# public.is_admin() in supabase/migrations/20260920000200_rls_policies.sql —
# if the two drift, the admin pages open but every write is rejected by RLS.
ADMIN_EMAIL=you@example.com
