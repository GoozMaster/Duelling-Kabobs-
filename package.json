{
  "name": "chef-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backfill:sources": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-source-urls.ts",
    "video:assets": "node -e \"require('fs').cpSync('src/assets/logos','video/public/art',{recursive:true})\"",
    "video:voice": "node video/tools/voice.mjs",
    "video:music": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON video/tools/music.mts",
    "video:captions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON video/tools/captions.mts",
    "video:studio": "remotion studio video/src/index.ts --public-dir=video/public",
    "video:render": "remotion render video/src/index.ts Explainer video/out/explainer-raw.mp4 --public-dir=video/public --codec=h264 --crf=18 --x264-preset=slow --image-format=png --audio-bitrate=192k",
    "video:finish": "node video/tools/finish.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.529",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.529",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "msedge-tts": "^2.0.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
