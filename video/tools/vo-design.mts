/**
 * The narration as a real-sound design fragment, plus the music's duck under it.
 *
 * The voice is the project's own (tools/voice.mjs), not a sourced recording, so
 * it rides on the amb bus — the film has no ambience — and is never audited or
 * credited. Line times come from the same timeline the picture uses.
 *
 *   node video/tools/vo-design.mts   → video/audio/design/vo.json, and the duck rides into audio/sounddesign.json
 */
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

import { buildTimeline } from "../src/timeline.ts";

const here = path.dirname(fileURLToPath(import.meta.url));
const root = path.resolve(here, "..");
const durations = JSON.parse(fs.readFileSync(path.join(root, "src/narration-timing.json"), "utf8"));
const { lines } = buildTimeline(durations);

const QA_OK = "the project's own narration (neural TTS), kept as it is by request; not a sourced recording";
const r3 = (x: number) => +x.toFixed(3);

const samples: Record<string, object> = {};
const place: object[] = [];
for (const [id, l] of Object.entries(lines)) {
  samples[`vo.${id}`] = { file: `public/vo/${id}.wav`, fade_in: 0.002, fade_out: 0.01, qa_ok: QA_OK };
  place.push({ sample: `vo.${id}`, at: r3(l.start), align: "start", bus: "amb", qa_ok: QA_OK });
}

fs.mkdirSync(path.join(root, "audio/design"), { recursive: true });
fs.writeFileSync(
  path.join(root, "audio/design/vo.json"),
  JSON.stringify({ _doc: `Generated by tools/vo-design.mts. ${QA_OK}.`, samples, place }, null, 1),
);

// The music ducks DUCK dB from 150 ms before each line to its end and comes back
// over half a second, as the old composition did; lines closer than that hold
// the duck through the gap rather than pumping. -16 rather than the first mix's
// -10: the voice was not reading clearly over the groove.
// Two lines ride lighter, LIGHT dB under: the title l11, so the drop lands
// big under it (the loudest moment follows as soon as the line ends), and the
// last line l26 from just before the placard, so the button chord on the slam
// reads and no duck release lifts its ring. At -3 (the first mix) both lines
// sat under the music; at -10 they still clear it.
const DUCK = -16;
const LIGHT = -10;
const PLACARD = lines.l26.start + 0.1; // scenes/close.tsx
const duckOf = (id: string) => (id === "l11" ? LIGHT : DUCK);
const rides: Array<[number, number]> = [[0, 0]];
const sorted = Object.values(lines).sort((a, b) => a.start - b.start);
sorted.forEach((l, i) => {
  const next = sorted[i + 1];
  const prev = sorted[i - 1];
  const d = duckOf(l.id);
  if (!prev || l.start - 0.15 > prev.end + 0.5) rides.push([r3(l.start - 0.15), 0], [r3(l.start), d]);
  else if (duckOf(prev.id) !== d) rides.push([r3(l.start - 0.15), duckOf(prev.id)], [r3(l.start), d]);
  if (l.id === "l26") {
    rides.push([r3(PLACARD - 0.18), d], [r3(PLACARD - 0.08), LIGHT]);
    return; // held to the end: the button rings out under it
  }
  if (!next || next.start - 0.15 > l.end + 0.5) rides.push([r3(l.end), d], [r3(l.end + 0.5), 0]);
  else if (duckOf(next.id) !== d) rides.push([r3(l.end), d]);
});

const designPath = path.join(root, "audio/sounddesign.json");
const design = JSON.parse(fs.readFileSync(designPath, "utf8"));
design.buses.music.auto = rides;
fs.writeFileSync(designPath, JSON.stringify(design, null, 1));
console.log(`duck: ${rides.length} points, ${DUCK} dB under the voice → audio/sounddesign.json`);
