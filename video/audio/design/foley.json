 "rules": [
  {
   "name": "fo.land.knock",
   "_doc": "soft wooden knocks: title card 0.55 and the close's hero art + wordmark (130.98-131.45)",
   "match": {
    "id": "^(open:thock:0|close:thock:[0-2])$"
   },
   "pool": "fo.knock",
   "mode": "cycle",
   "gain_db": -12,
   "jitter_db": 1.5,
   "pitch": [
    -0.3,
    0.3
   ],
   "pan": 0,
   "align": "attack"
  },
  {
   "name": "fo.land.notepad",
   "_doc": "the notepad's bounce-in at 8.78: a heavier take, 2 dB up",
   "match": {
    "id": "^list:thock:0$"
   },
   "pool": "fo.knock.heavy",
   "mode": "fixed",
   "gain_db": -12,
   "pan": 0,
   "align": "attack"
  },
  {
   "name": "fo.stamp.title",
   "_doc": "four recipe titles stamped (19.6-22.9): the same rubber stamp, four takes",
   "match": {
    "id": "^list:thock:[1-4]$"
   },
